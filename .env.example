# ExecOS — environment configuration
# Copy this file to `.env.development.local` or `.env.production.local` and fill in real values.
# The install script prompts for these and writes the selected environment file.
# Normal `execos` commands load `.env.production.local`; development commands load
# `.env.development.local` explicitly.
# `.env*local` and `.env` are gitignored; never commit real credentials.
# MCP/connector credentials are handled by the agent harness, not this file.

# Which Supabase target this file represents: development or production.
# Destructive tests use `.env.test.local` from `.env.test.example`, not this file.
EXECOS_DB_ENV=development

# ============================================================================
# Supabase — primary data layer (Postgres + pgvector + Storage)
# ============================================================================

# The full HTTPS URL of your Supabase project.
# The installer asks for the Project ID and writes this URL for you.
# Project ID location: Project Settings -> General -> Project ID.
# https://<project-id>.supabase.co
SUPABASE_URL=

# Optional friendly project name from Supabase Project Settings -> General.
# Used only for display in the local dashboard environment tooltip.
SUPABASE_PROJECT_NAME=

# Secret/server key — full API access; bypasses Row-Level Security.
# Used by the CLI for all write operations.
# Prefer a modern `sb_secret_...` key from Project Settings -> API Keys.
# Legacy `service_role` JWT keys also work.
# KEEP SECRET. Anyone with this key can read/write all your data.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable/anon key — read-only via RLS policies.
# Used by the local dashboard's server-load functions for read-only queries.
# Prefer a modern `sb_publishable_...` key from Project Settings -> API Keys.
# Legacy `anon` JWT keys also work.
SUPABASE_ANON_KEY=

# Postgres connection string for the CLI's Drizzle client and migration scripts.
# This is the Drizzle/pooler database URL (not the Supabase HTTPS endpoint) read by
# `src/db/index.ts`, `drizzle.config.ts`, `scripts/check-postgres.cjs`, and
# `scripts/migrate.ts`. The service role connects through Postgres directly,
# so this string carries the database password (not the service role JWT).
# The installer builds this from your Project ID and database password.
# Supabase source: green Connect button -> ORMs -> Drizzle -> DATABASE_URL.
# Format: postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# This is application data, not a destructive-test database. Dev and prod should
# use separate Supabase projects or branches. Destructive DB tests must only use
# `.env.test.local` from `.env.test.example`.
DATABASE_URL=

# Optional: override the default postgres-js pool size (default 5; keep small for CLI use).
# DB_POOL_MAX=5

# ============================================================================
# OpenAI — embeddings provider
# ============================================================================

# OpenAI API key. Used by the centralized embed() function (src/embeddings/index.ts)
# for memory RAG and duplicate detection.
OPENAI_API_KEY=

# ============================================================================
# Local runtime — optional overrides
# ============================================================================

# Dashboard server port. Default 3737.
DASHBOARD_PORT=3737

# Default timezone for natural-language date parsing.
# Installer default is Mountain Time. Format: IANA (e.g. America/Los_Angeles).
USER_DEFAULT_TIMEZONE=America/Denver
