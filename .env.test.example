# ExecOS — local destructive-test database configuration
# Copy to `.env.test.local` once on machines with local disposable test infrastructure.
# `.env.test.local` is gitignored; never point it at a hosted Supabase project.

EXECOS_DB_ENV=test

# Supabase local API defaults. Required by RLS tests that exercise anon access.
# Replace the blank keys with values printed by `supabase status` after
# `supabase start`. Do not use hosted Supabase dashboard keys here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Supabase CLI local Postgres default. The local DB harness migrates this
# database before the suite and resets local test data afterward.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Destructive DB tests use fake embeddings where possible.
OPENAI_API_KEY=

DASHBOARD_PORT=3737
USER_DEFAULT_TIMEZONE=America/Denver
