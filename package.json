{
  "name": "execos",
  "version": "0.1.0",
  "private": true,
  "description": "ExecOS: an AI chief of staff for founders. Agent-driven task management, memory, documents, and reviews on a Supabase + TypeScript foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/calvinl345/execos.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "execos": "./scripts/execos.mjs"
  },
  "scripts": {
    "execos": "node scripts/execos.mjs",
    "target": "node scripts/execos-target.mjs help",
    "target:help": "node scripts/execos-target.mjs help",
    "target:status": "node scripts/execos-target.mjs status",
    "target:prod": "node scripts/execos-target.mjs use production",
    "target:dev": "node scripts/execos-target.mjs use development",
    "sandbox": "node scripts/execos-target.mjs sandbox-start",
    "sandbox:start": "node scripts/execos-target.mjs sandbox-start",
    "sandbox:stop": "node scripts/execos-target.mjs sandbox-stop",
    "dev:web": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js dev",
    "dev:web:dev": "node scripts/run-with-env.cjs .env.development.local node node_modules/vite/bin/vite.js dev",
    "dev:web:prod": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js dev",
    "build:web": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js build",
    "build:web:dev": "node scripts/run-with-env.cjs .env.development.local node node_modules/vite/bin/vite.js build",
    "build:web:prod": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js build",
    "preview:web": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js preview",
    "preview:web:dev": "node scripts/run-with-env.cjs .env.development.local node node_modules/vite/bin/vite.js preview",
    "preview:web:prod": "node scripts/run-with-env.cjs .env.production.local node node_modules/vite/bin/vite.js preview",
    "check:web": "svelte-kit sync && svelte-check --tsconfig ./src/web/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx,.svelte",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config architecture/depcruise.cjs && vitest run --config vitest.architecture.config.ts",
    "arch:check:fast": "depcruise src --config architecture/depcruise.cjs",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:db": "node scripts/refuse-db-tests.cjs",
    "test:db:local": "node scripts/run-local-db-tests.cjs db",
    "test:migration": "vitest run --config vitest.migration.config.ts",
    "test:migration:local": "node scripts/run-local-db-tests.cjs migration",
    "test:migration:gate": "vitest run --config vitest.config.ts tests/_meta/migration-gate.test.ts",
    "test:all": "npm run test && npm run test:migration:gate",
    "test:check-pyramid": "bash scripts/check-test-pyramid.sh",
    "test:check-imports": "bash scripts/check-import-discipline.sh",
    "test:check-fast-reset": "bash scripts/check-fast-tests-no-resetDb.sh",
    "test:check-fast-budget": "bash scripts/check-fast-suite-budget.sh",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "db:check": "node scripts/run-with-env.cjs .env.production.local node scripts/check-postgres.cjs",
    "db:check:dev": "node scripts/run-with-env.cjs .env.development.local node scripts/check-postgres.cjs",
    "db:check:prod": "node scripts/run-with-env.cjs .env.production.local node scripts/check-postgres.cjs",
    "db:generate": "node scripts/run-with-env.cjs .env.production.local node node_modules/drizzle-kit/bin.cjs generate",
    "db:generate:dev": "node scripts/run-with-env.cjs .env.development.local node node_modules/drizzle-kit/bin.cjs generate",
    "db:generate:prod": "node scripts/run-with-env.cjs .env.production.local node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/migrate.ts up",
    "db:migrate:dev": "node scripts/run-with-env.cjs .env.development.local node --import=tsx scripts/migrate.ts up",
    "db:migrate:prod": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/migrate.ts up",
    "db:rollback": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/migrate.ts down",
    "db:rollback:dev": "node scripts/run-with-env.cjs .env.development.local node --import=tsx scripts/migrate.ts down",
    "db:rollback:prod": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/migrate.ts down",
    "db:check-drift": "node scripts/check-migration-drift.mjs",
    "db:check-safety": "node scripts/check-migration-safety.mjs",
    "db:guards": "node scripts/check-migration-safety.mjs && node scripts/check-migration-drift.mjs",
    "db:clone:dev-to-local": "node scripts/run-with-env.cjs .env.development.local node scripts/clone-to-local.mjs",
    "db:clone:prod-to-local": "node scripts/run-with-env.cjs .env.production.local node scripts/clone-to-local.mjs",
    "db:verify-migration": "node scripts/verify-migration.mjs",
    "db:seed": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/seed-app-settings.ts",
    "db:seed:dev": "node scripts/run-with-env.cjs .env.development.local node --import=tsx scripts/seed-app-settings.ts",
    "db:seed:prod": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/seed-app-settings.ts",
    "db:backfill-embeddings:dev": "node scripts/run-with-env.cjs .env.development.local node --import=tsx scripts/backfill-task-embeddings.ts",
    "db:backfill-embeddings:prod": "node scripts/run-with-env.cjs .env.production.local node --import=tsx scripts/backfill-task-embeddings.ts",
    "prepare": "svelte-kit sync && husky || echo 'prepare step skipped: re-run with npx svelte-kit sync and npx husky'",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:reset": "node scripts/demo-reset.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.14.0",
    "@supabase/supabase-js": "^2.104.1",
    "bits-ui": "^2.18.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.9",
    "open": "^11.0.0",
    "postgres": "^3.4.9",
    "yaml": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "supabase": "^2.105.0"
  }
}
